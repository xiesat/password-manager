<?xml version="1.0" encoding="utf-8"?>
<!-- 密码库不允许被系统备份/迁移导出 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
