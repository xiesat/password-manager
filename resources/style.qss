/* =====================================================================
   resources/style.qss — 密码管理器主题模板
   颜色以占位符书写，由 theme.py 在运行时替换为具体颜色（见 theme.py 的调色板）。
   请勿直接加载本文件；应用通过 theme.build_stylesheet(theme) 生成最终 QSS。
   ===================================================================== */

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 13px;
    color: @text;
}

QMainWindow, QDialog { background: @bg; }
QLabel { background: transparent; }

/* ---------------- 菜单 ---------------- */
QMenuBar { background: @surface; border-bottom: 1px solid @border; padding: 2px 6px; color: @text; }
QMenuBar::item { padding: 6px 12px; border-radius: 6px; background: transparent; }
QMenuBar::item:selected { background: @selBg; color: @brand; }
QMenu { background: @surface; border: 1px solid @border; border-radius: 8px; padding: 6px; color: @text; }
QMenu::item { padding: 7px 26px 7px 14px; border-radius: 6px; }
QMenu::item:selected { background: @selBg; color: @brand; }
QMenu::separator { height: 1px; background: @border; margin: 5px 8px; }

/* ---------------- 输入控件 ---------------- */
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background: @surfaceAlt;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 6px 10px;
    color: @text;
    selection-background-color: @brand;
    selection-color: @onBrand;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus,
QPlainTextEdit:focus, QTextEdit:focus { border: 1px solid @brand; background: @surface; }
QLineEdit:disabled, QSpinBox:disabled { color: @disabledText; }
QComboBox::drop-down { border: 0; width: 22px; }
QComboBox QAbstractItemView {
    background: @surface; border: 1px solid @border; border-radius: 8px;
    color: @text; selection-background-color: @selBg; selection-color: @text; outline: 0;
}

/* ---------------- 按钮 ----------------
   role="primary" / role="danger" / role="icon" 由 setProperty 指定 */
QPushButton {
    min-height: 20px;
    padding: 7px 16px;
    border: 1px solid @border;
    border-radius: 8px;
    background: @surface;
    color: @text;
}
QPushButton:hover { background: @hoverBg; border-color: @muted; }
QPushButton:pressed { background: @selBg; }
QPushButton:disabled { color: @disabledText; background: @surfaceAlt; border-color: @border; }

QPushButton[role="primary"] { background: @brand; border-color: @brand; color: @onBrand; font-weight: 600; }
QPushButton[role="primary"]:hover { background: @brandDark; border-color: @brandDark; }
QPushButton[role="primary"]:disabled { background: @disabledText; border-color: @disabledText; color: @surface; }

QPushButton[role="danger"] { background: @surface; border-color: @danger; color: @danger; }
QPushButton[role="danger"]:hover { background: @danger; color: @onBrand; }

QPushButton[role="icon"] { padding: 4px; min-width: 28px; border-color: transparent; background: transparent; }
QPushButton[role="icon"]:hover { background: @selBg; }

/* ---------------- 表格 ---------------- */
QTableView, QTreeView, QTreeWidget {
    background: @surface;
    alternate-background-color: @surfaceAlt;
    border: 1px solid @border;
    border-radius: 10px;
    gridline-color: @border;
    color: @text;
    selection-background-color: @selBg;
    selection-color: @selText;
}
QTableView::item, QTreeView::item { border: 0; padding: 4px 6px; }
QTableView::item:selected, QTreeView::item:selected { background: @selBg; color: @selText; }
QHeaderView::section {
    background: @headerBg; color: @muted; font-weight: 600;
    border: 0; border-bottom: 1px solid @border; padding: 8px 10px;
}
QHeaderView::section:hover { color: @text; }
QHeaderView::down-arrow, QHeaderView::up-arrow { width: 10px; height: 10px; }
QTableCornerButton::section { background: @headerBg; border: 0; }

/* ---------------- 状态栏 ---------------- */
QStatusBar { background: @headerBg; border-top: 1px solid @border; color: @muted; }
QStatusBar::item { border: 0; }

/* ---------------- 滚动条 ---------------- */
QScrollBar:vertical   { background: transparent; width: 10px;  margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:vertical   { background: @scrollHandle; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:horizontal { background: @scrollHandle; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:hover { background: @muted; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------------- 其他 ---------------- */
QToolTip { background: @tooltipBg; color: @tooltipText; border: 0; border-radius: 6px; padding: 6px 8px; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid @border; border-radius: 4px; background: @surface; }
QCheckBox::indicator:checked { background: @brand; border-color: @brand; }

QGroupBox {
    border: 1px solid @border; border-radius: 10px;
    margin-top: 14px; padding: 12px; background: @surface;
}
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; color: @muted; font-weight: 600; }

QProgressBar { border: 0; border-radius: 6px; background: @border; height: 8px; text-align: center; }
QProgressBar::chunk { border-radius: 6px; background: @brand; }
QDialogButtonBox QPushButton { min-width: 84px; }

/* 空状态页 */
#emptyStateTitle { font-size: 17px; font-weight: 600; color: @text; }
#emptyStateHint  { color: @muted; }
#brandTitle { font-size: 24px; font-weight: 700; color: @navy; }
